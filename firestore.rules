rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts must use the same document ID as the Firebase Auth UID.
    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }

    function activityPath(activityId) {
      return /databases/$(database)/documents/activities/$(activityId);
    }

    function signedIn() {
      return request.auth != null;
    }

    function hasAccount() {
      return signedIn() && exists(accountPath());
    }

    function activeAccount() {
      return hasAccount() && get(accountPath()).data.status == 'ACTIVE';
    }

    function hasRole(role) {
      return activeAccount() && get(accountPath()).data.role == role;
    }

    function isAdmin() {
      return hasRole('SECRETARIAT_ADMIN');
    }

    function isBK() {
      return hasRole('PETUGAS_BK');
    }

    function isScanOperator() {
      return hasRole('PETUGAS_SCAN');
    }

    function isPublicGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function hasAttendanceIdentityFields() {
      return request.resource.data.keys().hasAll([
        'activityId',
        'agendaId',
        'participantId',
        'participantType'
      ]) &&
      request.resource.data.activityId is string &&
      request.resource.data.agendaId == request.resource.data.activityId &&
      request.resource.data.participantId is string;
    }

    function activeActivity(activityId) {
      return get(activityPath(activityId)).data.status in ['ACTIVE', 'BERLANGSUNG', 'ONGOING', 'IN_PROGRESS'];
    }

    function hasDeviceAuditFields() {
      return request.resource.data.keys().hasAll([
        'deviceId',
        'deviceType',
        'deviceOS',
        'deviceBrowser'
      ]) &&
      request.resource.data.deviceId is string &&
      request.resource.data.deviceType is string &&
      request.resource.data.deviceOS is string &&
      request.resource.data.deviceBrowser is string &&
      request.resource.data.deviceId.size() > 0;
    }

    function validGpsData(activityId) {
      return request.resource.data.method != 'GPS_ONLINE' ||
        (request.resource.data.keys().hasAll(['lat', 'lng', 'distanceMeters']) &&
         request.resource.data.lat is number &&
         request.resource.data.lng is number &&
         request.resource.data.distanceMeters is number &&
         request.resource.data.distanceMeters >= 0 &&
         request.resource.data.distanceMeters <= get(activityPath(activityId)).data.radiusMeters);
    }

    function attendanceIdMatches(logId) {
      return (request.resource.data.participantType == 'EXTERNAL' &&
        logId == 'ATT-GST-' + request.resource.data.activityId + '-' + request.resource.data.participantId) ||
        (request.resource.data.participantType != 'EXTERNAL' &&
        logId == 'ATT-' + request.resource.data.activityId + '-' + request.resource.data.participantId);
    }

    function validParticipantAssignment(activityId) {
      return request.resource.data.participantType == 'EXTERNAL' &&
        request.resource.data.participantStatus == 'EXTERNAL' ||
        request.resource.data.participantType != 'EXTERNAL' &&
        request.resource.data.participantStatus in ['WAJIB_HADIR', 'UNDANGAN', 'OPSIONAL'] &&
        (!get(activityPath(activityId)).data.keys().hasAny(['participantStatuses']) ||
         !get(activityPath(activityId)).data.participantStatuses.keys().hasAny([request.resource.data.participantId]) ||
         get(activityPath(activityId)).data.participantStatuses[request.resource.data.participantId] == request.resource.data.participantStatus);
    }

    function attendanceIdentityUnchanged() {
      return request.resource.data.activityId == resource.data.activityId &&
        request.resource.data.agendaId == resource.data.agendaId &&
        request.resource.data.participantId == resource.data.participantId &&
        request.resource.data.participantType == resource.data.participantType &&
        ((!request.resource.data.keys().hasAny(['memberId']) && !resource.data.keys().hasAny(['memberId'])) ||
          request.resource.data.memberId == resource.data.memberId) &&
        ((!request.resource.data.keys().hasAny(['guestId']) && !resource.data.keys().hasAny(['guestId'])) ||
          request.resource.data.guestId == resource.data.guestId) &&
        request.resource.data.checkInAt == resource.data.checkInAt &&
        request.resource.data.deviceId == resource.data.deviceId &&
        request.resource.data.deviceType == resource.data.deviceType &&
        request.resource.data.deviceOS == resource.data.deviceOS &&
        request.resource.data.deviceBrowser == resource.data.deviceBrowser &&
        request.resource.data.method == resource.data.method;
    }

    function canCreateStaffAttendance() {
      return (isAdmin() || isBK() || isScanOperator() ||
        (activeAccount() && get(accountPath()).data.memberId == request.resource.data.memberId)) &&
        hasAttendanceIdentityFields() &&
        activeActivity(request.resource.data.activityId) &&
        hasDeviceAuditFields() &&
        validGpsData(request.resource.data.activityId) &&
        validParticipantAssignment(request.resource.data.activityId) &&
        (request.resource.data.participantType == 'EXTERNAL' ||
          (request.resource.data.memberId == request.resource.data.participantId &&
           (!get(activityPath(request.resource.data.activityId)).data.keys().hasAny(['participantMemberIds']) ||
            request.resource.data.memberId in get(activityPath(request.resource.data.activityId)).data.participantMemberIds)));
    }

    function canCreatePublicGuestAttendance() {
      return isPublicGuest() &&
        hasAttendanceIdentityFields() &&
        activeActivity(request.resource.data.activityId) &&
        hasDeviceAuditFields() &&
        validGpsData(request.resource.data.activityId) &&
        validParticipantAssignment(request.resource.data.activityId) &&
        request.resource.data.participantType == 'EXTERNAL' &&
        request.resource.data.invitationToken == get(activityPath(request.resource.data.activityId)).data.qrToken;
    }

    function canCreatePublicMemberAttendance() {
      return isPublicGuest() &&
        hasAttendanceIdentityFields() &&
        activeActivity(request.resource.data.activityId) &&
        hasDeviceAuditFields() &&
        validGpsData(request.resource.data.activityId) &&
        validParticipantAssignment(request.resource.data.activityId) &&
        request.resource.data.participantType == 'INTERNAL' &&
        request.resource.data.memberId == request.resource.data.participantId &&
        request.resource.data.invitationToken == get(activityPath(request.resource.data.activityId)).data.qrToken &&
        request.resource.data.memberId in get(activityPath(request.resource.data.activityId)).data.participantMemberIds;
    }

    function isAdminOrBK() {
      return isAdmin() || isBK();
    }

    function validRole(role) {
      return role in [
        'SECRETARIAT_ADMIN',
        'PETUGAS_BK',
        'PETUGAS_SCAN',
        'ANGGOTA_DPRD'
      ];
    }

    function validAccountStatus(status) {
      return status in ['ACTIVE', 'INACTIVE', 'SUSPENDED'];
    }

    function hasAccountFields() {
      return request.resource.data.keys().hasAll([
        'username',
        'usernameNormalized',
        'uid',
        'email',
        'fullName',
        'role',
        'status'
      ]) &&
      request.resource.data.username is string &&
      request.resource.data.usernameNormalized is string &&
      request.resource.data.uid is string &&
      request.resource.data.email is string &&
      request.resource.data.fullName is string &&
      request.resource.data.usernameNormalized.size() > 0 &&
      request.resource.data.uid.size() > 0 &&
      request.resource.data.email.size() > 0 &&
      request.resource.data.fullName.size() > 0;
    }

    function accountImmutableFieldsUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy &&
             request.resource.data.createdAt == resource.data.createdAt &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.username == resource.data.username &&
             request.resource.data.usernameNormalized == resource.data.usernameNormalized;
    }

    function hasServerUpdateMetadata() {
      return request.resource.data.updatedBy == request.auth.uid &&
             request.resource.data.updatedAt == request.time;
    }

    // ─── ACCOUNTS: whitelist managed by Admin ───────────────────────────────
    match /accounts/{accountId} {
      allow get: if isAdminOrBK() || (activeAccount() && request.auth.uid == accountId)
                  // Izinkan membaca akun sendiri berdasarkan UID (saat proses login/session restore)
                  || (signedIn() && request.auth.uid == accountId);
      // Izinkan list untuk user yang sudah terautentikasi - diperlukan saat login untuk
      // mencari akun berdasarkan usernameNormalized (query getDocs oleh accountService)
      allow list: if isAdminOrBK() || signedIn();

      // Izinkan create/update jika:
      // 1. User yang login adalah Admin (atau BK untuk non-Admin)
      // 2. Atau User baru terautentikasi dan mendaftarkan dokumen akunnya sendiri untuk pertama kali
      allow create: if (isAdmin() || (isBK() && request.resource.data.role != 'SECRETARIAT_ADMIN') ||
          (signedIn() && request.auth.uid == accountId && !exists(accountPath()))) &&
        hasAccountFields() &&
        validRole(request.resource.data.role) &&
        validAccountStatus(request.resource.data.status) &&
        request.resource.data.uid == accountId;

      allow update: if (isAdmin() ||
        (isBK() && resource.data.role != 'SECRETARIAT_ADMIN' && request.resource.data.role == resource.data.role) ||
        (signedIn() && request.auth.uid == accountId)) &&
        hasAccountFields() &&
        validRole(request.resource.data.role) &&
        validAccountStatus(request.resource.data.status);

      // Use INACTIVE/SUSPENDED instead of deleting accounts in production.
      allow delete: if false;
    }

    // ─── MEMBERS ────────────────────────────────────────────────────────────
    match /members/{memberId} {
      allow read: if activeAccount() || isPublicGuest();
      allow create, update: if isAdminOrBK();
      allow delete: if isAdmin();
    }

    // ─── PERSONNEL ──────────────────────────────────────────────────────────
    match /personnel/{personnelId} {
      allow read: if activeAccount();
      allow create, update: if isAdminOrBK();
      allow delete: if isAdmin();
    }

    // ─── ACTIVITIES ─────────────────────────────────────────────────────────
    match /activities/{activityId} {
      allow read: if activeAccount() || isPublicGuest();
      allow create: if isAdminOrBK();
      allow update: if isAdmin() ||
        (isBK() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();

      match /attendance/{attendanceId} {
        allow read: if activeAccount();
        allow create, update: if activeAccount();
        allow delete: if isAdminOrBK();
      }
    }

    // ─── ATTENDANCE LOGS ─────────────────────────────────────────────────────
    match /attendanceLogs/{logId} {
      // Admin & BK bisa baca semua log; Anggota hanya baca log miliknya sendiri;
      // PETUGAS_SCAN bisa baca semua log (untuk validasi duplikat saat scan)
      allow list: if isAdminOrBK() || isScanOperator() ||
        (isPublicGuest() && resource.data.participantType == 'EXTERNAL') ||
        (activeAccount() && resource.data.memberId == get(accountPath()).data.memberId);
      allow get: if isAdminOrBK() || isScanOperator() ||
        (isPublicGuest() && resource.data.participantType == 'EXTERNAL') ||
        (activeAccount() &&
         get(accountPath()).data.memberId == resource.data.memberId);
      // Anggota hanya boleh mencatat dirinya sendiri; operator dapat mencatat peserta.
      allow create: if (canCreateStaffAttendance() || canCreatePublicGuestAttendance() || canCreatePublicMemberAttendance()) &&
        attendanceIdMatches(logId);
      // Check-out adalah update pada log yang sama dan dapat dilakukan oleh pemilik atau operator.
      allow update: if attendanceIdentityUnchanged() &&
        (isAdminOrBK() || isScanOperator() ||
        (isPublicGuest() && resource.data.participantType == 'EXTERNAL' &&
          request.resource.data.invitationToken == resource.data.invitationToken) ||
        (isPublicGuest() && resource.data.participantType == 'INTERNAL' &&
          request.resource.data.invitationToken == resource.data.invitationToken &&
          request.resource.data.memberId == resource.data.memberId) ||
        (activeAccount() && get(accountPath()).data.memberId == resource.data.memberId &&
          request.resource.data.memberId == resource.data.memberId));
      allow delete: if isAdmin();
    }

    match /deletedAttendanceLogs/{logId} {
      allow read: if isAdminOrBK();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ─── BK NOTES ───────────────────────────────────────────────────────────
    match /bkNotes/{noteId} {
      allow read: if isAdminOrBK();
      allow create: if isAdminOrBK();
      allow update: if isAdmin() ||
        (isBK() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── AUDIT TRAILS ────────────────────────────────────────────────────────
    match /auditTrails/{trailId} {
      allow read: if isAdminOrBK();
      allow create: if isAdminOrBK() ||
        (signedIn() && request.auth.token.systemAccess == true);
      allow update, delete: if false;
    }

    // ─── ROOMS ──────────────────────────────────────────────────────────────
    match /rooms/{roomId} {
      allow read: if activeAccount();
      allow create, update, delete: if isAdminOrBK();
    }

    // ─── REPORT SIGNERS ─────────────────────────────────────────────────────
    match /reportSigners/{signerId} {
      allow read: if activeAccount();
      allow create, update, delete: if isAdminOrBK();
    }

    // ─── LEAVE REQUESTS ─────────────────────────────────────────────────────
    match /leaveRequests/{requestId} {
      allow read: if isAdminOrBK() ||
        (activeAccount() && resource.data.requestedBy == request.auth.uid);
      allow create: if activeAccount();
      allow update: if isAdminOrBK() ||
        (activeAccount() && resource.data.requestedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── SETTINGS ────────────────────────────────────────────────────────────
    match /settings/{key} {
      allow read: if activeAccount();
      allow write: if isAdmin();
    }

    // ─── DEFAULT DENY ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
  